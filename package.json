{
  "name": "pulse-win",
  "version": "1.0.0",
  "description": "A lightweight, elegant screen-edge monitor for AI coding allowances on Windows",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "build": "electron-builder"
  },
  "keywords": [
    "pulse",
    "ai",
    "monitor",
    "claude-code",
    "codex",
    "cursor",
    "antigravity"
  ],
  "author": "",
  "license": "Apache-2.0",
  "devDependencies": {
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "appId": "com.pulse.win",
    "productName": "Pulse",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "shortcutName": "Pulse",
      "runAfterFinish": true
    }
  }
}
