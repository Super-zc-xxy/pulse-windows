{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pulse",
  "version": "1.0.0",
  "identifier": "com.pulse.desktop",
  "build": {
    "beforeDevCommand": "node scripts/build-frontend.mjs",
    "beforeBuildCommand": "node scripts/build-frontend.mjs",
    "frontendDist": "../dist/frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"] }
}
